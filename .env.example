# ── CSSD database (optional) ──────────────────────────────────────────
# Leave CSSD_DB_SERVER empty and the dashboard works as before (Excel import
# only). Copy this file to .env.local and fill it in to enable
# "ดึงจากฐานข้อมูล". Use a READ-ONLY login (db_datareader) — never sa or the
# CSSD program's own login: the dashboard refuses a login that can write.

# Hospital server example (SQL Server Express named instance):
#   CSSD_DB_SERVER=localhost
#   CSSD_DB_INSTANCE=SQLEXPRESS      # needs the SQL Browser service, OR
#   CSSD_DB_PORT=1433                # a fixed TCP port instead of the instance name
CSSD_DB_SERVER=
CSSD_DB_INSTANCE=
CSSD_DB_PORT=
CSSD_DB_NAME=CSSD
CSSD_DB_USER=
# Wrap the password in double quotes — an unquoted "#" starts a comment and
# silently cuts the password short (login then fails with ELOGIN).
CSSD_DB_PASSWORD=""
# SQL Server Express uses a self-signed certificate, so trust it by default.
CSSD_DB_ENCRYPT=true
CSSD_DB_TRUST_SERVER_CERT=true

# Demo mode: built-in MADE-UP data (lib/supply/demo.ts) so the database
# screens work with no database at all — for online demos. Turns on by
# itself on Vercel when CSSD_DB_SERVER is empty; 1 = force on, 0 = force off.
# A configured database always wins.
CSSD_DEMO=

# Local MOCK database (db/docker-compose.yml) — these values only work
# against that throwaway container:
#   CSSD_DB_SERVER=127.0.0.1
#   CSSD_DB_PORT=1433
#   CSSD_DB_USER=dashboard_ro
#   CSSD_DB_PASSWORD="MockReadOnly#2568"
