# ค่าการเชื่อมต่อฐานข้อมูล CSSD ของ Med Dashboard
# ใส่รหัสผ่านของ login dashboard_ro ในบรรทัด CSSD_DB_PASSWORD (เก็บเครื่องหมายคำพูดไว้)
# (สคริปต์จะไม่ยอมเปิดถ้าบรรทัดนั้นยังเป็นค่าตัวอย่าง)
CSSD_DB_SERVER=localhost
CSSD_DB_PORT=1433
CSSD_DB_NAME=CSSD
CSSD_DB_USER=dashboard_ro
CSSD_DB_PASSWORD="CHANGE_ME"
CSSD_DB_ENCRYPT=true
CSSD_DB_TRUST_SERVER_CERT=true

# port ของหน้าเว็บ dashboard (เปิดที่ http://localhost:3001)
PORT=3001
